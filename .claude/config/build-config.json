{
  "context": {
    "warning_pct": 35,
    "critical_pct": 25,
    "auto_checkpoint": false,
    "stale_seconds": 60
  },
  "runtime": {
    "mode": "runtime",
    "stale_seconds": 900,
    "context_refresh_s": 45
  },
  "boundaries": [
    {
      "id": "hubspot-api",
      "name": "HubSpot API (CRM + correo curado)",
      "source": "docs/01-prd/portal-people-service.md#rf-9--integración-con-hubspot",
      "paths": [
        "packages/infra/src/hubspot/**"
      ],
      "credential_env": "HUBSPOT_PRIVATE_APP_TOKEN",
      "message_kinds": [
        "create-deal",
        "associate-contact-company",
        "create-contact",
        "timeline-note",
        "notify-owner"
      ],
      "na": null,
      "verified": []
    },
    {
      "id": "llm-interpreter",
      "name": "Gemini API (requerimientos pegados y propuestas de léxico)",
      "source": "docs/01-prd/portal-people-service.md#rf-16--contrato-del-modelo",
      "paths": [
        "packages/infra/src/gemini/**"
      ],
      "credential_env": "GEMINI_API_KEY",
      "message_kinds": [
        "extract-requirement-criteria",
        "suggest-lexicon-entries"
      ],
      "na": null,
      "verified": []
    },
    {
      "id": "otp-mail",
      "name": "Correo saliente: Mailgun desde notify@people.trycore.com (códigos de acceso, avisos y boletín) + webhook de eventos",
      "source": "docs/01-prd/portal-people-service.md#83-plataforma-de-ejecución-contenedores-en-digitalocean",
      "paths": [
        "packages/infra/src/mailgun/**",
        "apps/panel/app/api/v1/webhooks/mailgun/**"
      ],
      "credential_env": "MAILGUN_API_KEY",
      "message_kinds": [
        "send-access-code",
        "send-notification",
        "send-newsletter",
        "receive-delivery-event"
      ],
      "na": null,
      "verified": []
    }
  ]
}
