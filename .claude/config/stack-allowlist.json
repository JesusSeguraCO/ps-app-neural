{
  "_comment": "Allowlist de dependencias del proyecto. Derivada de la sección de requisitos técnicos del PRD. El hook stack-guard.sh bloquea dependencias fuera de `allow` al editar package.json.",
  "source": "docs/01-prd/portal-people-service.md#83-plataforma-de-ejecución-hosting-compartido-de-trycore",
  "version": "1.0",
  "runtime": {
    "node": ">=20 (solo compilación en local/CI; no corre en el hosting)",
    "packageManager": "npm (workspaces)",
    "php": "8.3",
    "mariadb": "10.6",
    "phpPackageManager": "composer"
  },
  "allow": [
    "next",
    "react",
    "react-dom",
    "typescript",
    "tailwindcss",
    "tailwindcss-animate",
    "@radix-ui/*",
    "class-variance-authority",
    "clsx",
    "tailwind-merge",
    "lucide-react",
    "nuqs",
    "next-themes",
    "vitest",
    "@testing-library/react",
    "fast-check",
    "@playwright/test",
    "@axe-core/playwright",
    "@lhci/cli",
    "eslint",
    "prettier",
    "slim/slim",
    "slim/psr7",
    "phpmailer/phpmailer",
    "phpunit/phpunit"
  ],
  "deny_examples": [
    "@google/generative-ai (Gemini solo desde PHP, ADR-0004)",
    "@prisma/client",
    "axios (usar fetch)",
    "express",
    "laravel/framework",
    "mongoose",
    "openai",
    "prisma",
    "symfony/*"
  ],
  "rationale": {
    "next": "ADR-0001",
    "react": "ADR-0001",
    "react-dom": "ADR-0001",
    "typescript": "ADR-0001",
    "tailwindcss": "ADR-0001",
    "tailwindcss-animate": "ADR-0001",
    "@radix-ui/*": "ADR-0001 (primitivas shadcn/ui)",
    "class-variance-authority": "ADR-0001",
    "clsx": "ADR-0001",
    "tailwind-merge": "ADR-0001",
    "lucide-react": "ADR-0001",
    "nuqs": "ADR-0001, ADR-0004",
    "next-themes": "ADR-0001",
    "vitest": "ADR-0007 (dev)",
    "@testing-library/react": "ADR-0007 (dev)",
    "fast-check": "ADR-0004 (dev)",
    "@playwright/test": "ADR-0007 (dev)",
    "@axe-core/playwright": "ADR-0007 (dev)",
    "@lhci/cli": "ADR-0007 (dev)",
    "eslint": "ADR-0007 (dev)",
    "prettier": "ADR-0007 (dev)",
    "slim/slim": "ADR-0001",
    "slim/psr7": "ADR-0001",
    "phpmailer/phpmailer": "ADR-0001, ADR-0005",
    "phpunit/phpunit": "ADR-0007 (dev)"
  }
}
