{
  "name": "portal-people-service",
  "private": true,
  "description": "Portal de Perfiles People Service — monorepo (ADR-0008)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:portal": "npm run dev -w @ps/portal",
    "dev:panel": "npm run dev -w @ps/panel",
    "dev:worker": "npm run dev -w @ps/worker",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "format": "prettier --write .",
    "test:e2e": "playwright test",
    "test:rendimiento": "lhci autorun --config=lighthouserc.cjs",
    "bd": "scripts/bd-local.sh"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "fast-check": "^4.10.2",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
